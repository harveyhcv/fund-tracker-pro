{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["dashboard/server.py"],
      "port": 8080
    },
    {
      "name": "miniapp",
      "runtimeExecutable": "python",
      "runtimeArgs": ["telegram-bot/miniapp/local_dev_server.py"],
      "port": 8443,
      "env": { "PORT": "8443" }
    },
    {
      "name": "local-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["telegram-bot/miniapp/local_dev_server.py"],
      "port": 8080,
      "url": "http://localhost:8080"
    },
    {
      "name": "verify-8555",
      "runtimeExecutable": "python",
      "runtimeArgs": ["telegram-bot/miniapp/local_dev_server.py"],
      "port": 8555,
      "env": { "PORT": "8555" },
      "url": "http://localhost:8555"
    },
    {
      "name": "miniapp-full",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import sys,json,os; sys.path.insert(0,'telegram-bot'); c=json.load(open('telegram-bot/config.json',encoding='utf-8')); os.environ['DATABASE_URL']=c['database_url']; import miniapp_server; miniapp_server.start_miniapp_server()"],
      "port": 8443
    }
  ]
}
