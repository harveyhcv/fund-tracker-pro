# Copy file này thành .env và điền thông tin thực tế
# KHÔNG commit .env lên git

# ── Bắt buộc ─────────────────────────────────────────────────
BOT_TOKEN=1234567890:AABBccDDeeFFggHHiiJJkkLLmmNNoo

# Chat ID của bạn (admin) — lấy bằng cách nhắn /getid cho bot
ADMIN_TELEGRAM_ID=123456789

# ── Server API Key (server.py) ───────────────────────────────
# Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
# Để trống khi chạy local (không exposed internet)
SERVER_API_KEY=

# ── Database Railway PostgreSQL ───────────────────────────────
# Lấy từ Railway Dashboard → Project → Variables → DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── TCBS Token ───────────────────────────────────────────────
# Lấy từ Dashboard: Cài đặt → TCBS → Xác thực OTP
# Bỏ trống nếu chỉ dùng quỹ fmarket (VCBF, SSI, etc.)
TCBS_TOKEN=

# ── Lịch gửi báo cáo (tuỳ chọn) ─────────────────────────────
MORNING_TIME=08:00
EVENING_TIME=17:30
SIGNAL_INTERVAL=60

# ── Chỉ dùng khi deploy Docker ───────────────────────────────
DATA_DIR=/data
