# Copy file này thành .env và điền thông tin thực tế
# KHÔNG commit .env lên git

# Bắt buộc
BOT_TOKEN=1234567890:AABBccDDeeFFggHHiiJJkkLLmmNNoo

# Chat ID của bạn (admin) — lấy bằng cách nhắn /getid cho bot
ADMIN_TELEGRAM_ID=123456789

# Tùy chọn — thay đổi lịch gửi báo cáo
MORNING_TIME=08:00
EVENING_TIME=17:30
SIGNAL_INTERVAL=60

# Chỉ dùng khi deploy Docker (đường dẫn lưu config.json + state.json)
DATA_DIR=/data
